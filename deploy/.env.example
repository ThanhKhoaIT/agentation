# Copy to .env and replace every value. Never commit .env.
# Generate passwords with: openssl rand -base64 24

# Claude Code / MCP clients (full access). Format: user:password
AGENTATION_AGENT_AUTH=agent:change-me-agent-password

# Browser extension (submit + read feedback of allowlisted domains). Format: user:password
# Anyone with the extension can read this value from the Workspace policy — keep it separate.
AGENTATION_INGEST_AUTH=extension:change-me-extension-password

# How long to keep the event log used for SSE replay (days)
AGENTATION_EVENT_RETENTION_DAYS=30

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install command)
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
