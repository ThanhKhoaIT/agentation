{
  "manifest_version": 3,
  "name": "Agentation",
  "version": "1.1.0",
  "description": "Visual feedback for AI coding agents",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "sidePanel", "identity", "identity.email", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Agentation",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
